# Porta em que a API vai rodar
PORT=4000

# Chave usada para assinar os tokens JWT.
# Em produção troque por um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-chave-em-producao

# Tempo de validade do token
JWT_EXPIRES_IN=7d

# Caminho do arquivo do banco SQLite (relativo à raiz do projeto)
DATABASE_FILE=data/financeiro.sqlite

# Origens autorizadas a chamar a API, separadas por vírgula.
# Em desenvolvimento é o servidor do Vite; em produção, a URL do frontend.
#   CORS_ORIGIN=http://localhost:5173,https://caixa-certo.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
